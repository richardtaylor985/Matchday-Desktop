{
  "name": "matchday-desktop",
  "version": "3.0.1",
  "private": true,
  "description": "Matchday Desktop Windows shell",
  "main": "desktop/main.js",
  "scripts": {
    "desktop": "electron .",
    "desktop:dev": "electron . --dev",
    "build:win": "electron-builder --win nsis",
    "screensaver": "electron . /s",
    "screensaver:config": "electron . /c",
    "build:scr": "electron-builder --win dir && node desktop/build-scr.js"
  },
  "devDependencies": {
    "electron": "^37.2.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.matchdaydesktop.app",
    "productName": "Matchday Desktop",
    "directories": {
      "output": "dist"
    },
    "files": [
      "desktop/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "engines": {
    "node": "22.x"
  }
}
