{
  "name": "matchday-desktop",
  "version": "3.2.10",
  "private": true,
  "description": "Matchday Desktop football screensaver and desktop application",
  "main": "desktop/main.js",
  "scripts": {
    "desktop": "electron .",
    "desktop:dev": "electron .",
    "build:win": "electron-builder --win nsis",
    "screensaver": "electron . /s",
    "screensaver:config": "electron . /c",
    "build:scr": "electron-builder --win dir && node desktop/build-scr.js",
    "build:installer": "npm run build:unpacked && electron-builder --win nsis --prepackaged dist/win-unpacked",
    "build:release": "npm run build:installer",
    "desktop:fullscreen": "electron . --fullscreen",
    "build:unpacked": "electron-builder --win dir && node desktop/prepare-scr.js",
    "desktop:dynamic-wallpaper": "electron . --dynamic-wallpaper"
  },
  "devDependencies": {
    "electron": "^37.2.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.matchdaydesktop.app",
    "productName": "Matchday Desktop",
    "directories": {
      "output": "dist"
    },
    "files": [
      "desktop/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Matchday Desktop",
      "uninstallDisplayName": "Matchday Desktop",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true,
      "include": "build/installer.nsh"
    },
    "artifactName": "Matchday-Desktop-Setup-${version}.${ext}",
    "extraResources": [
      {
        "from": "desktop",
        "to": "desktop-scripts",
        "filter": [
          "*.ps1"
        ]
      }
    ]
  },
  "engines": {
    "node": "22.x"
  }
}
